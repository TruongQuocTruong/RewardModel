# Whitelist: ignore everything, then re-include project code and configs only.
# Not tracked: checkpoints (output_training), logs, evaluation_results, datasets, backups.
/*
!/.gitignore
!/TrainingRewardModel/
!/TrainingDataSampling/
!/RewardModelEvaluation/

# TrainingRewardModel
/TrainingRewardModel/*
!/TrainingRewardModel/config_training.sh
!/TrainingRewardModel/config_stage2.sh
!/TrainingRewardModel/config_inspector_baseline.sh
!/TrainingRewardModel/config_student_stage1.sh
!/TrainingRewardModel/README.md
!/TrainingRewardModel/install_env.sh
# Slurm launchers stay in place on the server; the repo holds copies in script_slurm/
# (refreshed by .git/hooks/pre-commit).
!/TrainingRewardModel/script_slurm/
!/TrainingRewardModel/experiment_submissions.log
!/TrainingRewardModel/Scriptions/
!/TrainingRewardModel/Qwen3-VL-Embedding/
!/TrainingRewardModel/TrainingDataCreation/

/TrainingRewardModel/Qwen3-VL-Embedding/*
!/TrainingRewardModel/Qwen3-VL-Embedding/src/
!/TrainingRewardModel/Qwen3-VL-Embedding/scripts/
!/TrainingRewardModel/Qwen3-VL-Embedding/prompts/
!/TrainingRewardModel/Qwen3-VL-Embedding/pyproject.toml
!/TrainingRewardModel/Qwen3-VL-Embedding/uv.lock
!/TrainingRewardModel/Qwen3-VL-Embedding/LICENSE
!/TrainingRewardModel/Qwen3-VL-Embedding/.gitignore
!/TrainingRewardModel/Qwen3-VL-Embedding/logs/
!/TrainingRewardModel/Qwen3-VL-Embedding/logs/**
# output_training/ is kept as an empty folder (checkpoints are shared on Drive)
!/TrainingRewardModel/Qwen3-VL-Embedding/output_training/
/TrainingRewardModel/Qwen3-VL-Embedding/output_training/*
!/TrainingRewardModel/Qwen3-VL-Embedding/output_training/.gitkeep
/TrainingRewardModel/Qwen3-VL-Embedding/scripts/backups/

/TrainingRewardModel/TrainingDataCreation/*
!/TrainingRewardModel/TrainingDataCreation/*.py
!/TrainingRewardModel/TrainingDataCreation/*.slurm
!/TrainingRewardModel/TrainingDataCreation/*.jsonl
!/TrainingRewardModel/TrainingDataCreation/*.json
# 698 MB, over the GitHub 100 MB file limit (shared separately)
/TrainingRewardModel/TrainingDataCreation/editreward_overall_finegrained_gemmaGT_full.jsonl

# TrainingDataSampling
/TrainingDataSampling/*
!/TrainingDataSampling/*.py
!/TrainingDataSampling/*.csv
!/TrainingDataSampling/*.jsonl

# RewardModelEvaluation
/RewardModelEvaluation/*
!/RewardModelEvaluation/OurModel/
!/RewardModelEvaluation/OtherModels/
# EvalDatasets/: only the folders the user confirmed; no raw data (EditScore/Raw, Extracted).
!/RewardModelEvaluation/EvalDatasets/
/RewardModelEvaluation/EvalDatasets/*
!/RewardModelEvaluation/EvalDatasets/EditHF/
!/RewardModelEvaluation/EvalDatasets/EditReward/
/RewardModelEvaluation/EvalDatasets/EditReward/EditReward-Bench_VLM_judge/__MACOSX/
!/RewardModelEvaluation/EvalDatasets/EditScore/
/RewardModelEvaluation/EvalDatasets/EditScore/*
!/RewardModelEvaluation/EvalDatasets/EditScore/*.py
!/RewardModelEvaluation/EvalDatasets/EditScore/*.slurm
!/RewardModelEvaluation/EvalDatasets/EditScore/*.json

/RewardModelEvaluation/OurModel/*
!/RewardModelEvaluation/OurModel/*.py
!/RewardModelEvaluation/OurModel/*.slurm
# Not used by Stage 2 any more (kept on the server only)
/RewardModelEvaluation/OurModel/recompute_margin_auc.py
/RewardModelEvaluation/OurModel/recompute_overall_selected_metrics.py
/RewardModelEvaluation/OurModel/run_evaluate_reward_model.slurm
/RewardModelEvaluation/OurModel/run_evaluate_inspector_checkpoints.slurm
/RewardModelEvaluation/OurModel/infer_augmentation_relevance.py
/RewardModelEvaluation/OurModel/run_infer_augmentation_relevance.slurm
/RewardModelEvaluation/OurModel/plot_gradient_components.py

/RewardModelEvaluation/OtherModels/*
!/RewardModelEvaluation/OtherModels/*.py
!/RewardModelEvaluation/OtherModels/*.slurm
!/RewardModelEvaluation/OtherModels/EditHF/
!/RewardModelEvaluation/OtherModels/EditReward/
!/RewardModelEvaluation/OtherModels/Qwen3VLReranker/
/RewardModelEvaluation/OtherModels/EditHF/*
!/RewardModelEvaluation/OtherModels/EditHF/*.py
!/RewardModelEvaluation/OtherModels/EditHF/*.slurm
/RewardModelEvaluation/OtherModels/EditReward/*
!/RewardModelEvaluation/OtherModels/EditReward/*.py
!/RewardModelEvaluation/OtherModels/EditReward/*.slurm
/RewardModelEvaluation/OtherModels/Qwen3VLReranker/*
!/RewardModelEvaluation/OtherModels/Qwen3VLReranker/*.py
!/RewardModelEvaluation/OtherModels/Qwen3VLReranker/*.slurm

# Everywhere
__pycache__/
*.py[oc]
.ruff_cache/
